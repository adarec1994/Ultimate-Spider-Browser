//------------------------------------------------
//--- 010 Editor v12.0 Binary Template
//
//      File: PCM Model Template v1.6
//   Authors: Generated by Gemini
//   Purpose: Flattens scope to ensure 'Template Results' tree populates correctly.
//------------------------------------------------

LittleEndian();

// --- Colors ---
const int COL_HEADER = 0xDDDDDD;
const int COL_MODEL  = 0xE0E0FF; 
const int COL_SUBMESH= 0xE0FFE0; 
const int COL_VERTS  = 0xAAFFAA; 
const int COL_INDICES= 0xFFFFAA; 
const int COL_BONES  = 0xFFAAAA; 

// --- Helpers ---
typedef struct {
    uint32 offset;
    local int64 ret = FTell();
    if (offset > 0 && offset < FileSize()) {
        FSeek(offset + 4); 
        string value;
    }
    FSeek(ret);
} OffsetString <read=ReadOffsetString>;

string ReadOffsetString(OffsetString &s) {
    if (exists(s.value)) return s.value;
    return "";
}

typedef struct { float m[16]; } Matrix4x4;
typedef struct { Matrix4x4 matrix; } Bone <optimize=true>;

// --- Vertex Definition ---
typedef struct (int stride) {
    float x; float y; float z;
    if (stride == 24) { float u; float v; float nx; } 
    else if (stride == 64) {
        float nx; float ny; float nz;
        float u; float v;
        float bone_indices[4];
        float bone_weights[4];
    }
    else { if (stride > 12) ubyte unknown_data[stride - 12]; }
} Vertex <read=ReadVertex>;

string ReadVertex(Vertex &v) {
    string s; SPrintf(s, "%f, %f, %f", v.x, v.y, v.z); return s;
}

// --- Submesh ---

typedef struct { uint32 unk_00; uint32 offset; } SubmeshInfoOffset;

typedef struct {
    // 1. Header (Read inline)
    struct {
        OffsetString name_offset; 
        uint32 unk_04; uint32 unk_08; uint32 unk_0C;
        float  unk_floats[4];
        uint32 texture_hash <format=hex>;
        uint32 unk_24;
        uint32 itype; uint32 icnt; uint32 iofs;
        uint32 unk_34; uint32 vcnt; uint32 vofs;
        struct {
            uint32 unk_00; uint32 unk_04; uint32 stride;
            uint32 submesh_bone_map_count; uint32 submesh_bone_map_offset;
            uint32 unk_14; uint32 unk_18; uint32 unk_1C;
        } vertex_layout;
    } Header <bgcolor=COL_SUBMESH>;

    local int64 ret = FTell();
    
    // 2. Data Arrays (Defined directly so they appear in tree)
    
    // Bone Map
    if (Header.vertex_layout.submesh_bone_map_count > 0 && Header.vertex_layout.submesh_bone_map_offset > 0) {
        FSeek(Header.vertex_layout.submesh_bone_map_offset);
        uint16 BoneMap[Header.vertex_layout.submesh_bone_map_count];
    }

    // Vertices
    if (Header.vcnt > 0 && Header.vofs > 0) {
        FSeek(Header.vofs);
        Vertex Vertices(Header.vertex_layout.stride)[Header.vcnt] <optimize=false, bgcolor=COL_VERTS>;
    }

    // Indices
    if (Header.icnt > 0 && Header.iofs > 0) {
        FSeek(Header.iofs);
        uint16 Indices[Header.icnt] <bgcolor=COL_INDICES>;
    }

    FSeek(ret);
} Submesh <optimize=false, read=ReadSubmesh>;

string ReadSubmesh(Submesh &s) {
    string str;
    SPrintf(str, "%s (%d verts)", s.Header.name_offset.value, s.Header.vcnt);
    return str;
}


// --- Model ---

typedef struct {
    struct {
        OffsetString name_offset;
        uint32 unk_04; uint32 sub_count; uint32 sub_info_block_ofs;
        uint32 num_bn; uint32 ofs_bn; uint32 unk_bn; uint32 ofs_unk_bn;
        float  unk_floats[4];
    } Header <bgcolor=COL_MODEL>;

    local int64 ret = FTell();
    
    // Bones
    if (Header.num_bn > 0 && Header.ofs_bn > 0) {
        FSeek(Header.ofs_bn);
        Bone Bones[Header.num_bn] <bgcolor=COL_BONES>;
    }

    // Submeshes
    if (Header.sub_count > 0 && Header.sub_info_block_ofs > 0) {
        FSeek(Header.sub_info_block_ofs);
        SubmeshInfoOffset offsets[Header.sub_count];
        
        local int i;
        for(i = 0; i < Header.sub_count; i++) {
            if (offsets[i].offset > 0) {
                FSeek(offsets[i].offset);
                Submesh mesh;
            }
        }
    }

    FSeek(ret);
} ModelData <read=ReadModel>;

string ReadModel(ModelData &m) {
    if (exists(m.Header.name_offset.value)) 
        return m.Header.name_offset.value;
    return "ModelData";
}

// --- Main Execution (Global Scope) ---

struct {
    uint32 magic_padding[2];
    uint32 num_entries;
    uint32 info_ofs;
} FileHeader <bgcolor=COL_HEADER>;

struct Entry {
    uint16 type; uint16 tag; uint32 offset; uint32 size;
};

// 1. Jump to Entry Table
if (FileHeader.info_ofs > 0) {
    FSeek(FileHeader.info_ofs);
    Entry entries[FileHeader.num_entries] <read=ReadEntry>;

    // 2. Iterate and define Models (Global Scope Loop)
    local int i;
    for (i = 0; i < FileHeader.num_entries; i++) {
        if (entries[i].tag == 512) {
            FSeek(entries[i].offset);
            // This defines the variable in the global tree
            ModelData model; 
        }
    }
}

string ReadEntry(Entry &e) {
    string s; SPrintf(s, "Tag: %d, Size: %d", e.tag, e.size);
    if (e.tag == 512) s += " (Model)"; return s;
}